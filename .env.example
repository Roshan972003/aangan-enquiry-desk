# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Set to 1 to run without any LLM (canned replies, keyword verdicts) for plumbing tests only
MOCK_LLM=0

# Later: HubSpot private app token (scopes: crm.objects.contacts/deals/notes read+write)
HUBSPOT_TOKEN=
# Later: email + calendar invite. Without these, emails and .ics files are written to outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STUDIO_EMAIL=studio@example.com
STUDIO_HEAD_EMAIL=nikhil@example.com

# Cost assumptions (edit to match real vendor bills)
INR_PER_USD=88
GEMINI_IN_USD_PER_M=0.30
GEMINI_OUT_USD_PER_M=2.50
TELEPHONY_INR_PER_MIN=1.2
SPEECH_INR_PER_MIN=0.8

# Voice platform key (Vaani)
VAANI_API_KEY=

# Neon Postgres connection string (postgresql://user:pass@host/db?sslmode=require). Empty = local SQLite.
DATABASE_URL=

# Password for the dashboard and simulator (any username). Required on Vercel.
APP_PASSWORD=
